# ==========================================
# NEXUS AI ERP - BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Django Configuration
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=django-insecure-change-this-in-production-nexus-erp-super-secure-key-998877
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL)
# Use DATABASE_URL or individual DB_* parameters
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nexus_erp
DB_NAME=nexus_erp
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ais-dev-k2ed4tqv6vjov26duzrkp6-774750575332.asia-southeast1.run.app

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=jwt-secret-key-change-this-in-production

# AI / Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Celery / Redis (Optional for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# n8n Automation Webhook Dispatcher
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=n8n_secret_token_change_in_prod
